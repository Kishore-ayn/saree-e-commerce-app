# Copy this file to .env.local and fill in values from your Supabase
# project's dashboard: Project Settings -> API. Never commit .env.local.

# Safe to expose to the browser (used by the admin UI's Supabase client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security -- never import this in
# client-facing code, only in trusted server-side admin operations
# (e.g. bulk imports, seed scripts). Not used by the public site.
SUPABASE_SERVICE_ROLE_KEY=
